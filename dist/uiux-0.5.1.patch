+            dialog.setOnShowListener(ignored -> prepare(dialog, source));
+            return dialog;
+        }
+        @Override public AlertDialog show() {
+            AlertDialog dialog = super.show();
+            prepare(dialog, source);
+            return dialog;
+        }
+    }
